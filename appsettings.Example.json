{
  // Copy this file to appsettings.json (or set values via user-secrets) and fill in your own values.
  // Sensitive values (Email:Password, Ai:ApiKey) should go in user-secrets, NOT in a committed file:
  //   dotnet user-secrets set "Email:Password" "<gmail-app-password>"
  //   dotnet user-secrets set "Ai:ApiKey" "<openai-or-azure-key>"
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=DailyPilot;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Email": {
    "Enabled": false,
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseStartTls": true,
    "UserName": "your-account@gmail.com",
    "Password": "",
    "FromAddress": "no-reply@daypilot.app",
    "FromName": "DayPilot"
  },
  "Ai": {
    "Provider": "None",
    "Endpoint": "",
    "ApiKey": "",
    "Model": ""
  },
  "Admin": {
    "Emails": []
  },
  "Backup": {
    "Directory": "",
    "RetentionDays": 14
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Warning"
    }
  },
  "AllowedHosts": "*"
}
