// ============================================================================
//  DEPLOYMENT TEMPLATE — copy to "appsettings.Production.json" ON THE SERVER
//  (do NOT commit the real file; it holds secrets). In Production this file is
//  loaded automatically and overrides appsettings.json.
//  On MonsterASP, edit it via the File Manager / FTP after deploying.
// ============================================================================
{
  "ConnectionStrings": {
    // Paste the MS SQL connection string from your MonsterASP control panel.
    // It looks like the line below (Encrypt=False is required on MonsterASP):
    "DefaultConnection": "Server=dbXXXXX.public.databaseasp.net; Database=dbXXXXX; User Id=dbXXXXX; Password=YOUR_DB_PASSWORD; Encrypt=False; MultipleActiveResultSets=True; TrustServerCertificate=True;"
  },
  "Email": {
    "Enabled": true,
    "Host": "smtp.gmail.com",
    "Port": 587,
    "UseStartTls": true,
    "UserName": "hellofromfinoma@gmail.com",
    "Password": "YOUR_GMAIL_APP_PASSWORD",
    "FromAddress": "hellofromfinoma@gmail.com",
    "FromName": "DayPilot"
  },
  "Ai": {
    // Leave Provider "None" to use the built-in smart engine, or set OpenAI/AzureOpenAI + key.
    "Provider": "None",
    "Endpoint": "",
    "ApiKey": "",
    "Model": ""
  },
  "Admin": {
    // Emails that may open the Hangfire dashboard at /jobs (after they register).
    "Emails": [ "you@example.com" ]
  },
  "Backup": {
    // Shared hosting usually blocks BACKUP DATABASE — leave empty there.
    "Directory": "",
    "RetentionDays": 14
  }
}
