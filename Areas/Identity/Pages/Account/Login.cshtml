@page
@model LoginModel
@{
    ViewData["Title"] = "Log in";
}

<div class="dp-auth">
    <div class="dp-auth-card">
        <div class="text-center mb-4">
            <span class="dp-auth-logo"><i class="bi bi-compass-fill"></i></span>
            <h1 class="h3 mt-3 mb-1">Welcome back</h1>
            <p class="text-muted mb-0">Log in to continue to DayPilot</p>
        </div>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email</label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" autofocus />
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Password</label>
                <div class="input-group">
                    <input asp-for="Input.Password" id="Input_Password" class="form-control" autocomplete="current-password" placeholder="Your password" />
                    <button class="btn btn-outline-secondary dp-pw-toggle" type="button" data-pw-toggle="#Input_Password" tabindex="-1" title="Show / hide password">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="form-check">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe">Remember me</label>
                </div>
                <a class="small" asp-page="./ForgotPassword">Forgot password?</a>
            </div>

            <button id="login-submit" type="submit" class="btn btn-primary w-100 btn-lg">Log in</button>
        </form>

        <p class="text-center text-muted mt-4 mb-0">
            New to DayPilot? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
