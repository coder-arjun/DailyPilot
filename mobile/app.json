{
  "expo": {
    "name": "DayPilot",
    "slug": "daypilot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/daypilot-logo.png",
    "scheme": "daypilot",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0f1d",
    "android": {
      "package": "com.daypilot.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0a0f1d",
        "foregroundImage": "./assets/images/daypilot-logo-maskable.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0f1d",
          "image": "./assets/images/daypilot-logo.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-location",
      [
        "expo-notifications",
        {
          "color": "#6366F1",
          "defaultChannel": "reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://dailypilot.runasp.net/api/v1"
    }
  }
}
