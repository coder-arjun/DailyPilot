@model WorkspaceDetailsViewModel
@using DailyPilot.Models
@{ ViewData["Title"] = Model.Workspace.Name; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><span class="badge" style="background-color:@Model.Workspace.Color">&nbsp;</span> @Model.Workspace.Name</h2>
    <a class="btn btn-outline-secondary" asp-action="Board" asp-route-id="@Model.Workspace.Id"><i class="bi bi-kanban"></i> Team board</a>
</div>
@if (!string.IsNullOrWhiteSpace(Model.Workspace.Description))
{
    <p class="text-muted">@Model.Workspace.Description</p>
}

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card"><div class="card-body">
            <h5 class="card-title">Members</h5>
            <table class="table align-middle">
                <thead><tr><th>Member</th><th>Role</th><th></th></tr></thead>
                <tbody>
                @foreach (var m in Model.Members)
                {
                    var isOwnerRow = m.UserId == Model.Workspace.OwnerId;
                    <tr>
                        <td>@(m.User?.DisplayName ?? m.User?.UserName) <div class="small text-muted">@m.User?.Email</div></td>
                        <td>
                            @if (Model.CanManage && !isOwnerRow)
                            {
                                <form asp-action="ChangeRole" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Workspace.Id" />
                                    <input type="hidden" name="targetUserId" value="@m.UserId" />
                                    <select name="role" class="form-select form-select-sm d-inline w-auto" onchange="this.form.submit()">
                                        <option value="@WorkspaceRole.Admin" selected="@(m.Role == WorkspaceRole.Admin)">Admin</option>
                                        <option value="@WorkspaceRole.Member" selected="@(m.Role == WorkspaceRole.Member)">Member</option>
                                    </select>
                                </form>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@m.Role</span>
                            }
                        </td>
                        <td class="text-end">
                            @if (Model.CanManage && !isOwnerRow)
                            {
                                <form asp-action="RemoveMember" method="post" class="d-inline" onsubmit="return confirm('Remove this member?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@Model.Workspace.Id" />
                                    <input type="hidden" name="targetUserId" value="@m.UserId" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit"><i class="bi bi-person-x"></i></button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div></div>
    </div>

    <div class="col-lg-5">
        @if (Model.CanManage)
        {
            <div class="card mb-3"><div class="card-body">
                <h5 class="card-title">Invite a member</h5>
                <form asp-action="Invite" method="post" class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Workspace.Id" />
                    <div class="col-7">
                        <label class="form-label">Email</label>
                        <input name="email" type="email" class="form-control" required />
                    </div>
                    <div class="col-3">
                        <label class="form-label">Role</label>
                        <select name="role" class="form-select">
                            <option value="@WorkspaceRole.Member">Member</option>
                            <option value="@WorkspaceRole.Admin">Admin</option>
                        </select>
                    </div>
                    <div class="col-2">
                        <button class="btn btn-primary w-100" type="submit">Invite</button>
                    </div>
                </form>

                @if (Model.PendingInvitations.Any())
                {
                    <hr />
                    <h6>Pending</h6>
                    @foreach (var inv in Model.PendingInvitations)
                    {
                        <div class="d-flex justify-content-between align-items-center py-1">
                            <span class="small">@inv.Email <span class="badge bg-light text-dark">@inv.Role</span></span>
                            <form asp-action="RevokeInvitation" method="post" class="m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Workspace.Id" />
                                <input type="hidden" name="invitationId" value="@inv.Id" />
                                <button class="btn btn-sm btn-link text-danger p-0" type="submit">Revoke</button>
                            </form>
                        </div>
                    }
                }
            </div></div>
        }

        <div class="card"><div class="card-body">
            <h5 class="card-title">Actions</h5>
            @if (Model.IsOwner)
            {
                <form asp-action="Delete" method="post" onsubmit="return confirm('Delete this workspace? Tasks will be returned to members as personal tasks.');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Workspace.Id" />
                    <button class="btn btn-outline-danger" type="submit"><i class="bi bi-trash"></i> Delete workspace</button>
                </form>
            }
            else
            {
                <form asp-action="Leave" method="post" onsubmit="return confirm('Leave this workspace?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Workspace.Id" />
                    <button class="btn btn-outline-warning" type="submit"><i class="bi bi-box-arrow-left"></i> Leave workspace</button>
                </form>
            }
        </div></div>
    </div>
</div>
