@model List<TaskHistory>
@{
    ViewData["Title"] = "History";
    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;
    string Badge(string action) => action switch
    {
        "Completed" => "bg-success",
        "Created" => "bg-primary",
        "Deleted" => "bg-danger",
        "CarriedForward" => "bg-warning text-dark",
        "Reopened" => "bg-secondary",
        _ => "bg-info text-dark"
    };
}

<h2 class="mb-3"><i class="bi bi-clock-history"></i> Task History</h2>

@if (!Model.Any())
{
    <p class="text-muted">No activity yet.</p>
}
else
{
    <div class="card"><div class="table-responsive">
        <table class="table dp-history-table align-middle mb-0">
            <thead><tr><th>When</th><th>Action</th><th>Task</th><th>Details</th></tr></thead>
            <tbody>
            @foreach (var h in Model)
            {
                <tr>
                    <td class="small text-nowrap">@h.Timestamp.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                    <td><span class="badge @Badge(h.Action)">@h.Action</span></td>
                    <td>@h.TaskTitle</td>
                    <td class="small text-muted">@h.Details</td>
                </tr>
            }
            </tbody>
        </table>
    </div></div>

    <partial name="_Pager" model="@(new PagerViewModel { Page = page, TotalPages = totalPages, Action = "Index", Controller = "History" })" />
}
