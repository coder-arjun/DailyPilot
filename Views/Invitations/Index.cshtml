@model InvitationsIndexViewModel
@{ ViewData["Title"] = "Invitations"; }

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h2 class="mb-0"><i class="bi bi-envelope-paper-heart"></i> Invitations</h2>
        <small class="text-muted">Organise who to invite — and never miss anyone.</small>
    </div>
    <a class="btn btn-outline-secondary" asp-action="Events"><i class="bi bi-sliders"></i> Manage events</a>
</div>

<div class="card dp-invite-new mb-4">
    <div class="card-body">
        <h5 class="card-title mb-3"><i class="bi bi-plus-circle"></i> New invitation list</h5>
        <form asp-action="Create" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-4">
                <label class="form-label small text-muted">Event</label>
                <select name="eventTypeId" class="form-select" required>
                    @foreach (var e in Model.Events)
                    {
                        <option value="@e.Id" data-icon="@e.Icon">@e.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label small text-muted">Group name</label>
                <input name="groupName" class="form-control" maxlength="100" placeholder="e.g. Office colleagues, College friends" required />
            </div>
            <div class="col-md-3 d-grid">
                <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Create list</button>
            </div>
        </form>
    </div>
</div>

@if (!Model.Lists.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-envelope-paper" style="font-size:3rem;"></i>
        <p class="mt-2">No invitation lists yet. Pick an event and name your group above to start.</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var l in Model.Lists)
        {
            <div class="col-md-6 col-xl-4">
                <div class="dp-invite-card h-100">
                    <a class="dp-invite-card-main" asp-action="Details" asp-route-id="@l.Id">
                        <div class="dp-invite-badge"><i class="bi bi-@l.EventIcon"></i></div>
                        <div class="flex-grow-1 min-w-0">
                            <div class="dp-invite-event">@l.EventName</div>
                            <div class="dp-invite-group text-truncate">@l.GroupName</div>
                        </div>
                    </a>
                    <div class="dp-invite-meta">
                        <div class="d-flex justify-content-between small mb-1">
                            <span><strong>@l.Invited</strong> / @l.Total invited</span>
                            @if (l.Pending > 0) { <span class="text-warning-emphasis">@l.Pending pending</span> }
                            else if (l.Total > 0) { <span class="text-success">All invited ✓</span> }
                        </div>
                        <div class="dp-xp-track"><span style="width:@l.Percent%"></span></div>
                    </div>
                    <div class="dp-invite-actions">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@l.Id"><i class="bi bi-list-check"></i> Open</a>
                        <form asp-action="DeleteList" method="post" class="m-0" onsubmit="return confirm('Delete this list and all its people?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@l.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
