@model InviteListDetailsViewModel
@{ ViewData["Title"] = Model.List.GroupName; }

<div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
    <div class="d-flex align-items-center gap-3">
        <div class="dp-invite-badge lg"><i class="bi bi-@Model.List.EventIcon"></i></div>
        <div>
            <div class="text-muted small text-uppercase" style="letter-spacing:.06em">@Model.List.EventName</div>
            <h2 class="mb-0">@Model.List.GroupName</h2>
        </div>
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index"><i class="bi bi-chevron-left"></i> All lists</a>
</div>

<div class="card mb-3"><div class="card-body py-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <span><strong>@Model.Invited</strong> of <strong>@Model.Total</strong> invited</span>
        <span class="text-muted small">@Model.Pending still to invite</span>
    </div>
    <div class="dp-xp-track" style="height:10px"><span style="width:@Model.Percent%"></span></div>
</div></div>

<div class="card mb-3"><div class="card-body">
    <form asp-action="AddInvitee" method="post" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <input type="hidden" name="listId" value="@Model.List.Id" />
        <div class="col-md-6">
            <label class="form-label small text-muted">Add a person</label>
            <input name="name" class="form-control" maxlength="120" placeholder="Full name" required autofocus />
        </div>
        <div class="col-md-4">
            <label class="form-label small text-muted">Phone / email <span class="text-muted">(optional)</span></label>
            <input name="contact" class="form-control" maxlength="60" placeholder="Optional" />
        </div>
        <div class="col-md-2 d-grid">
            <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add</button>
        </div>
    </form>
</div></div>

@if (!Model.Invitees.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-person-plus" style="font-size:3rem;"></i>
        <p class="mt-2">No one on this list yet. Add everyone above so you don't miss anybody.</p>
    </div>
}
else
{
    <form asp-action="Confirm" method="post" id="inviteConfirmForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="listId" value="@Model.List.Id" />
        <div class="card"><div class="table-responsive">
            <table class="table dp-invite-table align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:52px" class="text-center">
                            <input class="form-check-input" type="checkbox" id="dpSelAll" title="Select everyone" />
                        </th>
                        <th>Name</th>
                        <th class="d-none d-md-table-cell">Phone / email</th>
                        <th style="width:120px">Status</th>
                        <th style="width:48px"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.Invitees)
                    {
                        <tr class="@(p.IsInvited ? "is-invited" : "is-pending")">
                            <td class="text-center">
                                <input class="form-check-input dp-inv-check" type="checkbox" name="invitedIds" value="@p.Id" @(p.IsInvited ? "checked" : "") />
                            </td>
                            <td class="fw-medium">@p.Name</td>
                            <td class="d-none d-md-table-cell text-muted">@(string.IsNullOrWhiteSpace(p.Contact) ? "—" : p.Contact)</td>
                            <td>
                                @if (p.IsInvited)
                                {
                                    <span class="badge rounded-pill dp-pill-invited"><i class="bi bi-check-lg"></i> Invited</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill dp-pill-pending"><i class="bi bi-hourglass"></i> Pending</span>
                                }
                            </td>
                            <td class="text-end">
                                <button type="submit" formaction="@Url.Action("DeleteInvitee")" formnovalidate
                                        name="id" value="@p.Id" class="btn btn-sm btn-link text-muted p-0"
                                        onclick="return confirm('Remove this person?');" title="Remove">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div></div>

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
            <span class="text-muted small"><i class="bi bi-info-circle"></i> Tick everyone you've invited, then confirm. People still to invite are listed first.</span>
            <button type="submit" class="btn btn-primary btn-lg px-4"><i class="bi bi-check2-circle"></i> Confirm invitations</button>
        </div>
    </form>
}

@section Scripts {
    <script>
        (function () {
            var all = document.getElementById('dpSelAll');
            var boxes = document.querySelectorAll('.dp-inv-check');
            if (!all || !boxes.length) return;
            function sync() { all.checked = [...boxes].every(b => b.checked); }
            all.addEventListener('change', function () { boxes.forEach(b => b.checked = all.checked); });
            boxes.forEach(b => b.addEventListener('change', sync));
            sync();
        })();
    </script>
}
