@model InviteListDetailsViewModel
@using System.Text.Json
@{
    ViewData["Title"] = Model.List.GroupName;
    var initial = JsonSerializer.Serialize(Model.Invitees.Select(i => new { id = i.Id, name = i.Name, contact = i.Contact, invited = i.IsInvited }));
}

<div class="d-flex flex-wrap justify-content-between align-items-start mb-3 gap-2">
    <div class="d-flex align-items-center gap-3">
        <div class="dp-invite-badge lg"><i class="bi bi-@Model.List.EventIcon"></i></div>
        <div>
            <div class="text-muted small text-uppercase" style="letter-spacing:.06em">@Model.List.EventName</div>
            <h2 class="mb-0">@Model.List.GroupName</h2>
        </div>
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index"><i class="bi bi-chevron-left"></i> All lists</a>
</div>

<div class="card mb-3"><div class="card-body py-3">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <span><strong id="invCount">@Model.Invited</strong> of <strong id="invTotal">@Model.Total</strong> invited</span>
        <span class="text-muted small"><span id="invPending">@Model.Pending</span> still to invite</span>
    </div>
    <div class="dp-xp-track" style="height:10px"><span id="invBar" style="width:@Model.Percent%"></span></div>
</div></div>

<div class="card mb-3"><div class="card-body">
    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label small text-muted">Add a person</label>
            <input id="invName" class="form-control" maxlength="120" placeholder="Full name" autofocus />
        </div>
        <div class="col-md-4">
            <label class="form-label small text-muted">Phone / email <span class="text-muted">(optional)</span></label>
            <input id="invContact" class="form-control" maxlength="60" placeholder="Optional" />
        </div>
        <div class="col-md-2 d-grid">
            <button type="button" id="invAdd" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add</button>
        </div>
    </div>
    <div class="form-text mt-2"><i class="bi bi-info-circle"></i> Nothing is saved until you press <strong>Confirm invitations</strong>.</div>
</div></div>

<form asp-action="Confirm" method="post" id="inviteConfirmForm">
    @Html.AntiForgeryToken()
    <input type="hidden" name="listId" value="@Model.List.Id" />
    <input type="hidden" name="payload" id="invitePayload" />

    <div class="card"><div class="table-responsive">
        <table class="table dp-invite-table align-middle mb-0">
            <thead>
                <tr>
                    <th style="width:52px" class="text-center"><input class="form-check-input" type="checkbox" id="invSelAll" title="Select everyone" /></th>
                    <th>Name</th>
                    <th>Phone / email</th>
                    <th style="width:120px">Status</th>
                    <th style="width:48px"></th>
                </tr>
            </thead>
            <tbody id="invBody"></tbody>
        </table>
        <div id="invEmpty" class="text-center text-muted py-5 d-none">
            <i class="bi bi-person-plus" style="font-size:2.6rem;"></i>
            <p class="mt-2 mb-0">No one on this list yet. Add everyone above so you don't miss anybody.</p>
        </div>
    </div></div>

    <div class="dp-invite-footer mt-3">
        <span class="text-muted small"><i class="bi bi-info-circle"></i> Tick everyone you've invited. People still to invite are listed first.</span>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-action="Index" id="invCancel">Cancel</a>
            <button type="submit" class="btn btn-primary px-4"><i class="bi bi-check2-circle"></i> Confirm invitations</button>
        </div>
    </div>
</form>

<script id="inviteData" type="application/json">@Html.Raw(initial)</script>

@section Scripts {
    <script>
        (function () {
            var data = [];
            try { data = JSON.parse(document.getElementById('inviteData').textContent || '[]'); } catch (e) { }
            var tbody = document.getElementById('invBody');
            var empty = document.getElementById('invEmpty');
            var nameIn = document.getElementById('invName');
            var contactIn = document.getElementById('invContact');
            var selAll = document.getElementById('invSelAll');
            var form = document.getElementById('inviteConfirmForm');
            var payload = document.getElementById('invitePayload');
            var dirty = false;

            function esc(s) { var d = document.createElement('div'); d.textContent = s == null ? '' : s; return d.innerHTML; }
            function pill(inv) {
                return inv
                    ? '<span class="badge rounded-pill dp-pill-invited"><i class="bi bi-check-lg"></i> Invited</span>'
                    : '<span class="badge rounded-pill dp-pill-pending"><i class="bi bi-hourglass"></i> Pending</span>';
            }
            function rowEl(item) {
                var tr = document.createElement('tr');
                tr.className = 'dp-inv-row ' + (item.invited ? 'is-invited' : 'is-pending');
                tr.dataset.id = item.id || 0;
                tr.dataset.name = item.name || '';
                tr.dataset.contact = item.contact || '';
                tr.innerHTML =
                    '<td class="dp-inv-cell-chk text-center"><input type="checkbox" class="form-check-input dp-inv-check"' + (item.invited ? ' checked' : '') + '></td>' +
                    '<td class="dp-inv-name fw-medium">' + esc(item.name) + '</td>' +
                    '<td class="dp-inv-contact text-muted">' + (item.contact ? esc(item.contact) : '<span class="opacity-50">—</span>') + '</td>' +
                    '<td class="dp-inv-status">' + pill(item.invited) + '</td>' +
                    '<td class="dp-inv-cell-act text-end"><button type="button" class="btn btn-sm btn-link text-muted p-0 dp-inv-remove" title="Remove"><i class="bi bi-x-lg"></i></button></td>';
                return tr;
            }
            function refresh() {
                var rows = [].slice.call(tbody.querySelectorAll('.dp-inv-row'));
                empty.classList.toggle('d-none', rows.length > 0);
                var inv = 0;
                rows.forEach(function (r) {
                    var c = r.querySelector('.dp-inv-check').checked;
                    r.classList.toggle('is-invited', c);
                    r.classList.toggle('is-pending', !c);
                    r.querySelector('.dp-inv-status').innerHTML = pill(c);
                    if (c) inv++;
                });
                document.getElementById('invCount').textContent = inv;
                document.getElementById('invTotal').textContent = rows.length;
                document.getElementById('invPending').textContent = (rows.length - inv);
                document.getElementById('invBar').style.width = (rows.length ? Math.round(inv * 100 / rows.length) : 0) + '%';
                if (selAll) selAll.checked = rows.length > 0 && inv === rows.length;
            }
            function addRow(item) { tbody.appendChild(rowEl(item)); }

            data.forEach(addRow);
            refresh();

            document.getElementById('invAdd').addEventListener('click', function () {
                var n = (nameIn.value || '').trim();
                if (!n) { nameIn.focus(); return; }
                addRow({ id: 0, name: n, contact: (contactIn.value || '').trim(), invited: false });
                nameIn.value = ''; contactIn.value = ''; nameIn.focus();
                dirty = true; refresh();
            });
            [nameIn, contactIn].forEach(function (el) {
                el.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); document.getElementById('invAdd').click(); } });
            });

            tbody.addEventListener('click', function (e) {
                var b = e.target.closest('.dp-inv-remove');
                if (b) { b.closest('.dp-inv-row').remove(); dirty = true; refresh(); }
            });
            tbody.addEventListener('change', function (e) {
                if (e.target.classList.contains('dp-inv-check')) { dirty = true; refresh(); }
            });
            if (selAll) selAll.addEventListener('change', function () {
                tbody.querySelectorAll('.dp-inv-check').forEach(function (c) { c.checked = selAll.checked; });
                dirty = true; refresh();
            });

            var submitting = false;
            form.addEventListener('submit', function () {
                submitting = true;
                var rows = [].slice.call(tbody.querySelectorAll('.dp-inv-row')).map(function (r) {
                    return {
                        id: parseInt(r.dataset.id || '0', 10) || 0,
                        name: (r.dataset.name || '').trim(),
                        contact: (r.dataset.contact || '').trim(),
                        invited: r.querySelector('.dp-inv-check').checked
                    };
                });
                payload.value = JSON.stringify(rows);
            });

            document.getElementById('invCancel').addEventListener('click', function (e) {
                if (dirty && !confirm('Discard your unsaved changes?')) e.preventDefault();
            });
            window.addEventListener('beforeunload', function (e) {
                if (dirty && !submitting) { e.preventDefault(); e.returnValue = ''; }
            });
        })();
    </script>
}
