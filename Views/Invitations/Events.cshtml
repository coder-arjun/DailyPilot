@model List<EventType>
@{
    ViewData["Title"] = "Event types";
    var icons = new (string Icon, string Label)[]
    {
        ("gift","Gift"), ("heart","Heart"), ("calendar-heart","Calendar heart"), ("balloon","Balloon"),
        ("briefcase","Briefcase"), ("emoji-smile","Smile"), ("house-heart","House"), ("people","People"),
        ("cake2","Cake"), ("cup-hot","Cup"), ("music-note-beamed","Music"), ("trophy","Trophy"),
        ("stars","Stars"), ("flower1","Flower"), ("calendar-event","Calendar"),
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h2 class="mb-0"><i class="bi bi-sliders"></i> Event types</h2>
        <small class="text-muted">Your master list of events used when creating invitation lists.</small>
    </div>
    <a class="btn btn-outline-secondary btn-sm" asp-action="Index"><i class="bi bi-chevron-left"></i> Back to invitations</a>
</div>

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card"><div class="card-body">
            <h5 class="card-title mb-3"><i class="bi bi-plus-circle"></i> Add event</h5>
            <form asp-action="CreateEvent" method="post">
                @Html.AntiForgeryToken()
                <div class="mb-3">
                    <label class="form-label small text-muted">Name</label>
                    <input name="name" class="form-control" maxlength="60" placeholder="e.g. Graduation, Reunion" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">Icon</label>
                    <div class="d-flex align-items-center gap-2">
                        <span class="dp-invite-badge sm"><i class="bi bi-calendar-event" id="iconPreview"></i></span>
                        <select name="icon" class="form-select" id="iconSelect">
                            @foreach (var ic in icons)
                            {
                                <option value="@ic.Icon">@ic.Label</option>
                            }
                        </select>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add event</button>
            </form>
        </div></div>
    </div>

    <div class="col-lg-7">
        <div class="card"><div class="card-body">
            <h5 class="card-title mb-3">Your events</h5>
            @if (!Model.Any())
            {
                <p class="text-muted mb-0">No event types yet.</p>
            }
            else
            {
                <div class="dp-event-grid">
                    @foreach (var e in Model)
                    {
                        <div class="dp-event-chip">
                            <span class="dp-invite-badge sm"><i class="bi bi-@e.Icon"></i></span>
                            <span class="flex-grow-1">@e.Name</span>
                            <form asp-action="DeleteEvent" method="post" class="m-0" onsubmit="return confirm('Delete “@e.Name”? Existing lists keep their event name.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@e.Id" />
                                <button type="submit" class="btn btn-sm btn-link text-muted p-0"><i class="bi bi-x-lg"></i></button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div></div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var sel = document.getElementById('iconSelect'), prev = document.getElementById('iconPreview');
            if (sel && prev) sel.addEventListener('change', function () { prev.className = 'bi bi-' + sel.value; });
        })();
    </script>
}
