@model TaskFormViewModel
@{ ViewData["Title"] = "Add task"; }

<h2 class="mb-3"><i class="bi bi-plus-lg"></i> Add task</h2>

<div class="card">
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <partial name="_TaskForm" model="Model" />
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save</button>
            <a class="btn btn-outline-secondary" asp-action="Index" asp-route-date="@Model.PlannedDate.ToString("yyyy-MM-dd")">Cancel</a>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
