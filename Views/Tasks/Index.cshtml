@model TodayViewModel
@{
    ViewData["Title"] = "Today";
    var prev = Model.Date.AddDays(-1);
    var next = Model.Date.AddDays(1);
    string PriorityBadge(Priority p) => p switch
    {
        Priority.High => "bg-danger",
        Priority.Medium => "bg-warning text-dark",
        _ => "bg-secondary"
    };
    string PriorityColor(Priority p) => p switch
    {
        Priority.High => "#ef4444",
        Priority.Medium => "#f59e0b",
        _ => "#94a3b8"
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">@Model.Date.ToString("dddd, dd MMM yyyy")</h2>
        <small class="text-muted">@Model.CompletedCount of @Model.TotalCount done
            @if (Model.CarriedForwardCount > 0) { <span class="text-warning">· @Model.CarriedForwardCount carried forward</span> }
        </small>
    </div>
    <div class="btn-group">
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-date="@prev.ToString("yyyy-MM-dd")"><i class="bi bi-chevron-left"></i></a>
        <a class="btn btn-outline-secondary" asp-action="Index">Today</a>
        <a class="btn btn-outline-secondary" asp-action="Index" asp-route-date="@next.ToString("yyyy-MM-dd")"><i class="bi bi-chevron-right"></i></a>
    </div>
</div>

@if (Model.WorkspaceId is not null)
{
    <div class="alert alert-primary d-flex justify-content-between align-items-center py-2">
        <span><i class="bi bi-people"></i> Viewing your tasks in <strong>@Model.WorkspaceName</strong></span>
        <a class="btn btn-sm btn-outline-primary" asp-controller="Workspaces" asp-action="Board" asp-route-id="@Model.WorkspaceId"><i class="bi bi-kanban"></i> Team board</a>
    </div>
}

<div class="progress mb-3" style="height: 8px;">
    <div class="progress-bar bg-success" style="width: @Model.CompletionRate%"></div>
</div>

<form asp-controller="Ai" asp-action="QuickAdd" method="post" class="mb-3">
    @Html.AntiForgeryToken()
    <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
    <div class="input-group">
        <span class="input-group-text"><i class="bi bi-stars text-primary"></i></span>
        <input type="text" name="text" class="form-control"
               placeholder="Quick add with natural language, e.g. &quot;Email report tomorrow at 3pm high priority for 30 min&quot;" />
        <button type="submit" class="btn btn-primary">Add</button>
    </div>
    <small class="text-muted">Understands dates, times, priority, duration, recurrence and categories.</small>
</form>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-end mb-3">
    <form method="get" class="row g-2 align-items-end">
        <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
        <div class="col-auto">
            <label class="form-label mb-0 small">Category</label>
            <select name="categoryId" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c.Id" selected="@(Model.FilterCategoryId == c.Id)">@c.Name</option>
                }
            </select>
        </div>
        <div class="col-auto">
            <label class="form-label mb-0 small">Priority</label>
            <select name="priority" class="form-select form-select-sm">
                <option value="">All</option>
                @foreach (Priority p in Enum.GetValues<Priority>())
                {
                    <option value="@p" selected="@(Model.FilterPriority == p)">@p</option>
                }
            </select>
        </div>
        @if (Model.Tags.Any())
        {
            <div class="col-auto">
                <label class="form-label mb-0 small">Tag</label>
                <select name="tagId" class="form-select form-select-sm">
                    <option value="">All</option>
                    @foreach (var tag in Model.Tags)
                    {
                        <option value="@tag.Id" selected="@(Model.FilterTagId == tag.Id)">@tag.Name</option>
                    }
                </select>
            </div>
        }
        <div class="col-auto">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="hideCompleted" value="true" id="hc" checked="@Model.HideCompleted" />
                <label class="form-check-label small" for="hc">Hide completed</label>
            </div>
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-sm btn-outline-primary">Filter</button>
        </div>
    </form>
    <a class="btn btn-primary" asp-action="Create" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")"><i class="bi bi-plus-lg"></i> Add task</a>
</div>

@if (!Model.Tasks.Any())
{
    <div class="text-center text-muted py-5">
        <i class="bi bi-clipboard-check" style="font-size:3rem;"></i>
        <p class="mt-2">No tasks for this day. Add one to get started!</p>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var t in Model.Tasks)
        {
            <div class="col-md-6 col-xl-4">
                <div class="dp-task-card p-3 d-flex flex-column h-100 @(t.IsCompleted ? "is-done" : "")" style="--dp-task-accent:@PriorityColor(t.Priority)">
                    <div class="d-flex align-items-start gap-2">
                        <form asp-action="ToggleComplete" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@t.Id" />
                            <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
                            <button type="submit" class="dp-task-check @(t.IsCompleted ? "done" : "")" title="Toggle complete">
                                <i class="bi @(t.IsCompleted ? "bi-check-lg" : "")"></i>
                            </button>
                        </form>
                        <div class="flex-grow-1">
                            <div class="dp-task-title">@t.Title</div>
                            @if (!string.IsNullOrWhiteSpace(t.Notes))
                            {
                                <div class="small text-muted text-truncate" style="max-width:100%;">@t.Notes</div>
                            }
                            <div class="mt-2 d-flex flex-wrap gap-1">
                                <span class="dp-chip @PriorityBadge(t.Priority)">@t.Priority</span>
                                @if (t.Category is not null)
                                {
                                    <span class="dp-chip text-white" style="background-color:@t.Category.Color">@t.Category.Name</span>
                                }
                                @if (t.DueTime is not null) { <span class="dp-chip bg-body-secondary text-body"><i class="bi bi-clock"></i> @t.DueTime.Value.ToString("HH:mm")</span> }
                                @if (t.EstimatedMinutes is not null) { <span class="dp-chip bg-body-secondary text-body"><i class="bi bi-hourglass"></i> @t.EstimatedMinutes m</span> }
                                @if (t.Recurrence != RecurrencePattern.None) { <span class="dp-chip bg-body-secondary text-body"><i class="bi bi-arrow-repeat"></i> @t.Recurrence</span> }
                                @if (t.CarryForwardCount > 0) { <span class="dp-chip bg-warning-subtle text-warning-emphasis"><i class="bi bi-arrow-right-circle"></i> ×@t.CarryForwardCount</span> }
                                @foreach (var tag in t.Tags)
                                {
                                    <span class="dp-chip bg-body-secondary text-body"><i class="bi bi-tag"></i> @tag.Name</span>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="mt-auto pt-3 d-flex justify-content-end gap-1">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@t.Id"><i class="bi bi-pencil"></i></a>
                        <form asp-action="Delete" method="post" class="m-0" onsubmit="return confirm('Delete this task?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@t.Id" />
                            <input type="hidden" name="date" value="@Model.Date.ToString("yyyy-MM-dd")" />
                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
