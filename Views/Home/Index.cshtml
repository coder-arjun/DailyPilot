@{ ViewData["Title"] = "Welcome"; }

<div class="dp-hero">
    <span class="dp-auth-logo mx-auto"><i class="bi bi-compass-fill"></i></span>
    <h1 class="dp-hero-title fw-bold mt-4">DayPilot</h1>
    <p class="lead text-muted">Plan. Complete. Move Forward.</p>
    <p class="col-lg-6 mx-auto text-muted">
        The productivity companion that plans your day, tracks your habits, and
        automatically carries unfinished tasks forward — so nothing slips through.
    </p>
    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center mt-4">
        <a class="btn btn-primary btn-lg px-5" asp-area="Identity" asp-page="/Account/Login">
            <i class="bi bi-box-arrow-in-right"></i> Log in
        </a>
    </div>
</div>

<div class="row g-4 py-5 col-lg-10 mx-auto">
    <div class="col-md-4 text-center">
        <span class="dp-feature-icon mb-3"><i class="bi bi-arrow-right-circle"></i></span>
        <h5>Automatic Carry Forward</h5>
        <p class="text-muted">Unfinished work rolls to the next day for you — never lose track again.</p>
    </div>
    <div class="col-md-4 text-center">
        <span class="dp-feature-icon mb-3"><i class="bi bi-stars"></i></span>
        <h5>AI Assistant &amp; Coach</h5>
        <p class="text-muted">Natural-language planning, smart prioritisation, and a daily coach.</p>
    </div>
    <div class="col-md-4 text-center">
        <span class="dp-feature-icon mb-3"><i class="bi bi-people"></i></span>
        <h5>Teams &amp; Habits</h5>
        <p class="text-muted">Collaborate in shared workspaces and build streaks that last.</p>
    </div>
</div>
