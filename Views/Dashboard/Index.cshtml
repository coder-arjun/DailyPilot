@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var game = ViewBag.Gamification as DailyPilot.Services.GamificationSummary;
}

<h2 class="mb-3"><i class="bi bi-bar-chart-line"></i> Productivity Dashboard</h2>

@if (game is not null)
{
    <div class="card mb-4 dp-level-card">
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-center gap-3 mb-2">
                <div class="dp-level-badge">@game.Level.Level</div>
                <div class="flex-grow-1">
                    <div class="d-flex justify-content-between flex-wrap">
                        <strong>Level @game.Level.Level · @game.Level.Title</strong>
                        <span class="text-muted small">@game.Level.Xp XP · @game.Level.XpToNext to next</span>
                    </div>
                    <div class="dp-xp-track mt-1"><span style="width:@game.Level.ProgressPct%"></span></div>
                    <div class="text-muted small mt-1">@game.TasksCompleted tasks completed · @game.EarnedBadgeCount / @game.Badges.Count badges earned</div>
                </div>
            </div>
            <div class="dp-badges">
                @foreach (var b in game.Badges)
                {
                    <div class="dp-badge @(b.Earned ? "earned" : "locked")" title="@b.Name — @b.Description">
                        <i class="bi @b.Icon"></i>
                        <span>@b.Name</span>
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card text-bg-primary h-100"><div class="card-body">
            <div class="small">Completed today</div>
            <div class="display-6">@Model.CompletedToday / @Model.PlannedToday</div>
            <div class="small">@Model.TodayCompletionRate% completion</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card text-bg-success h-100"><div class="card-body">
            <div class="small">Weekly completion rate</div>
            <div class="display-6">@Model.WeeklyCompletionRate%</div>
            <div class="small">last 7 days</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card text-bg-warning h-100"><div class="card-body">
            <div class="small">Carry-forward rate</div>
            <div class="display-6">@Model.CarryForwardRate%</div>
            <div class="small">lower is better</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card text-bg-dark h-100"><div class="card-body">
            <div class="small">🔥 Current streak</div>
            <div class="display-6">@Model.CurrentStreak</div>
            <div class="small">longest: @Model.LongestStreak days</div>
        </div></div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Last 7 days</h5>
            <canvas id="trendChart" height="140"></canvas>
        </div></div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100"><div class="card-body">
            <h5 class="card-title">Category performance</h5>
            @if (!Model.CategoryPerformance.Any())
            {
                <p class="text-muted">No data yet.</p>
            }
            else
            {
                <div class="table-responsive">
                <table class="table table-sm">
                    <thead><tr><th>Category</th><th>Done</th><th>Rate</th></tr></thead>
                    <tbody>
                    @foreach (var c in Model.CategoryPerformance)
                    {
                        <tr>
                            <td>@c.Category</td>
                            <td>@c.Completed / @c.Total</td>
                            <td>
                                <div class="progress" style="height:16px;">
                                    <div class="progress-bar" style="width:@c.Rate%">@c.Rate%</div>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                </div>
            }
        </div></div>
    </div>
</div>

<div class="card mt-3"><div class="card-body">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="card-title mb-0">Activity</h5>
        <div class="d-flex align-items-center gap-1 small text-muted">
            Less
            @for (int l = 0; l <= 4; l++) { <span class="dp-heat-cell level-@l"></span> }
            More
        </div>
    </div>
    <div class="dp-heatmap">
        @{
            var weeks = Model.Heatmap.Chunk(7).ToList();
        }
        @foreach (var week in weeks)
        {
            <div class="dp-heat-col">
                @foreach (var day in week)
                {
                    <span class="dp-heat-cell level-@day.Level" title="@day.Date.ToString("ddd, dd MMM yyyy"): @day.Completed completed"></span>
                }
            </div>
        }
    </div>
    <div class="small text-muted mt-2">Completed tasks per day over the last ~6 months.</div>
</div></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trend.Select(t => t.Date.ToString("ddd"))));
        const completed = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trend.Select(t => t.Completed)));
        const planned = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trend.Select(t => t.Planned)));
        new Chart(document.getElementById('trendChart'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    { label: 'Completed', data: completed, backgroundColor: '#198754' },
                    { label: 'Planned', data: planned, backgroundColor: '#0d6efd' }
                ]
            },
            options: { responsive: true, scales: { y: { beginAtZero: true, ticks: { precision: 0 } } } }
        });
    </script>
}
