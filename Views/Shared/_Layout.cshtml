@using Microsoft.AspNetCore.Identity
@using DailyPilot.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject DailyPilot.Services.IWorkspaceService WorkspaceService
@inject DailyPilot.Services.IWorkspaceContext WorkspaceContext
@inject DailyPilot.Services.IGamificationService Gamification
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    var currentUser = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var signedIn = SignInManager.IsSignedIn(User);

    // Slate & Titanium is the single, permanent theme (theme switching removed).
    const string palette = "titanium";
    const string bsTheme = "dark";
    const string themeColor = "#121214";
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";

    var myWorkspaces = currentUser is not null ? await WorkspaceService.GetUserWorkspacesAsync(currentUser.Id) : new();
    var currentWsId = WorkspaceContext.CurrentWorkspaceId;
    var currentWs = myWorkspaces.FirstOrDefault(w => w.Id == currentWsId);
    var returnUrl = ViewContext.HttpContext.Request.Path + ViewContext.HttpContext.Request.QueryString;

    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(params string[] controllers) => controllers.Contains(ctrl) ? "active" : "";

    var vapidKey = Config["Push:PublicKey"];
    var speakReminders = currentUser?.SpeakReminders == true;
    var level = currentUser is not null ? Gamification.Describe(currentUser.Xp) : null;
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="@bsTheme" data-dp-theme="@palette">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DayPilot</title>
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="@themeColor" id="dp-theme-color" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="DayPilot" />
    <link rel="apple-touch-icon" href="~/icons/logo-192.png" />
    <link rel="icon" type="image/png" id="dp-favicon" href="~/icons/logo-192.png" />

    @* Link preview (WhatsApp / social share of the invite) — Slate & Titanium logo *@
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DayPilot" />
    <meta property="og:title" content="DayPilot — Plan. Complete. Move Forward." />
    <meta property="og:description" content="Your daily task companion — auto carry-forward, reminders, habits, and an AI coach." />
    <meta property="og:url" content="@baseUrl" />
    <meta property="og:image" content="@(baseUrl)/icons/logo-512.png" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="DayPilot — Plan. Complete. Move Forward." />
    <meta name="twitter:description" content="Your daily task companion — auto carry-forward, reminders, habits, and an AI coach." />
    <meta name="twitter:image" content="@(baseUrl)/icons/logo-512.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DailyPilot.styles.css" asp-append-version="true" />
</head>
<body>
    @if (signedIn)
    {
        @Html.AntiForgeryToken()
    }
    <header>
        <nav class="navbar navbar-expand-lg dp-navbar sticky-top" aria-label="Primary">
            <div class="container-fluid px-lg-4">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-compass-fill"></i> DayPilot
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNav" aria-controls="mobileNav" aria-label="Open menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="offcanvas offcanvas-end mobile-drawer" tabindex="-1" id="mobileNav" aria-labelledby="mobileNavLabel">
                    <div class="offcanvas-header">
                        <span class="mobile-drawer-brand" id="mobileNavLabel">
                            <span class="mobile-drawer-seal"><i class="bi bi-compass-fill"></i></span>
                            <span>DayPilot</span>
                        </span>
                        <button type="button" class="mobile-drawer-close" data-bs-dismiss="offcanvas" aria-label="Close menu">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                    <div class="offcanvas-body">
                        @if (signedIn)
                        {
                            <form class="mobile-drawer-search d-lg-none" role="search" asp-controller="Search" asp-action="Index" method="get">
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                                    <input type="search" name="q" class="form-control" placeholder="Search everything…" autocomplete="off" aria-label="Search" />
                                </div>
                            </form>
                            <div class="mobile-drawer-label d-lg-none">Navigate</div>
                        }

                        <ul class="navbar-nav flex-grow-1">
                            @if (signedIn)
                            {
                                <li class="nav-item"><a class="nav-link @Active("Tasks")" asp-controller="Tasks" asp-action="Index"><i class="bi bi-check2-square"></i> Today</a></li>
                                <li class="nav-item"><a class="nav-link" asp-controller="Tasks" asp-action="Board"><i class="bi bi-kanban"></i> Board</a></li>
                                <li class="nav-item"><a class="nav-link @Active("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-graph-up-arrow"></i> Dashboard</a></li>
                                <li class="nav-item"><a class="nav-link @Active("Habits")" asp-controller="Habits" asp-action="Index"><i class="bi bi-trophy"></i> Habits</a></li>
                                <li class="nav-item"><a class="nav-link @Active("Ai")" asp-controller="Ai" asp-action="Index"><i class="bi bi-stars"></i> Assistant</a></li>
                                <li class="nav-item"><a class="nav-link @Active("Calendar")" asp-controller="Calendar" asp-action="Index"><i class="bi bi-calendar3"></i> Calendar</a></li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle @Active("Workspaces","History","Categories","Invitations")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-three-dots"></i> More</a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item @Active("Invitations")" asp-controller="Invitations" asp-action="Index"><i class="bi bi-envelope-paper-heart"></i> Invitations</a></li>
                                        <li><a class="dropdown-item" asp-controller="Tasks" asp-action="Matrix"><i class="bi bi-grid-3x3-gap"></i> Eisenhower Matrix</a></li>
                                        <li><a class="dropdown-item @Active("Categories")" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags"></i> Categories</a></li>
                                        <li><a class="dropdown-item" asp-controller="Workspaces" asp-action="Index"><i class="bi bi-people"></i> Workspaces</a></li>
                                        <li><a class="dropdown-item" asp-controller="History" asp-action="Index"><i class="bi bi-clock-history"></i> History</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" href="#" onclick="window.dpOpenPalette&&window.dpOpenPalette();return false;"><i class="bi bi-command"></i> Command palette <kbd class="ms-1">Ctrl K</kbd></a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><a class="dropdown-item" href="#" id="inviteItem"><i class="bi bi-share"></i> Invite a friend</a></li>
                                        <li><a class="dropdown-item d-none" href="#" id="pwaInstallItem"><i class="bi bi-download"></i> Install app</a></li>
                                    </ul>
                                </li>
                            }
                        </ul>

                        @if (signedIn)
                        {
                            <div class="mobile-drawer-label d-lg-none">Workspace &amp; account</div>
                        }

                        <div class="nav-utility d-flex align-items-center gap-2">
                            @if (signedIn)
                            {
                                <form class="navbar-search d-none d-lg-flex" role="search" asp-controller="Search" asp-action="Index" method="get">
                                    <div class="dp-search">
                                        <i class="bi bi-search"></i>
                                        <input type="search" name="q" class="form-control form-control-sm" placeholder="Search…" value="@(Context.Request.Query["q"])" aria-label="Search" />
                                    </div>
                                </form>

                                <ul class="navbar-nav">
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-@(currentWs is null ? "person-workspace" : "people")"></i>
                                            <span>@(currentWs?.Name ?? "Personal")</span>
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li>
                                                <form asp-controller="Workspaces" asp-action="Switch" method="post" class="m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                    <button class="dropdown-item @(currentWs is null ? "active" : "")" type="submit"><i class="bi bi-person"></i> Personal</button>
                                                </form>
                                            </li>
                                            @if (myWorkspaces.Any())
                                            {
                                                <li><hr class="dropdown-divider" /></li>
                                                foreach (var ws in myWorkspaces)
                                                {
                                                    <li>
                                                        <form asp-controller="Workspaces" asp-action="Switch" method="post" class="m-0">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@ws.Id" />
                                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                            <button class="dropdown-item @(currentWsId == ws.Id ? "active" : "")" type="submit"><span class="badge" style="background-color:@ws.Color">&nbsp;</span> @ws.Name</button>
                                                        </form>
                                                    </li>
                                                }
                                            }
                                            <li><hr class="dropdown-divider" /></li>
                                            <li><a class="dropdown-item" asp-controller="Workspaces" asp-action="Index"><i class="bi bi-gear"></i> Manage workspaces</a></li>
                                        </ul>
                                    </li>
                                </ul>
                            }

                            @if (signedIn && level is not null)
                            {
                                <a class="dp-xp-pill" asp-controller="Dashboard" asp-action="Index" title="Level @level.Level · @level.Xp XP (@level.XpToNext XP to next)">
                                    <span class="dp-xp-lvl">Lv @level.Level</span>
                                    <span class="dp-xp-bar"><span style="width:@level.ProgressPct%"></span></span>
                                </a>
                            }

                            <ul class="navbar-nav">
                                @if (signedIn)
                                {
                                    <li class="nav-item dropdown">
                                        <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bi bi-person-circle"></i>
                                            <span>@(currentUser?.DisplayName ?? UserManager.GetUserName(User))</span>
                                        </a>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear"></i> Settings</a></li>
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post" class="m-0">
                                                    <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Logout</button>
                                                </form>
                                            </li>
                                        </ul>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-2 dp-main">
        @if (signedIn && !string.IsNullOrWhiteSpace(vapidKey))
        {
            <div id="dpNotifyBar" class="alert alert-primary d-none align-items-center justify-content-between flex-wrap gap-2" role="alert">
                <span><i class="bi bi-bell"></i> Turn on notifications to get task reminders on this device.</span>
                <span class="d-flex gap-2">
                    <button class="btn btn-sm btn-primary" type="button" data-push-enable>Enable</button>
                    <button class="btn btn-sm btn-outline-secondary" type="button" data-push-test>Send test</button>
                    <button class="btn btn-sm btn-link text-muted" type="button" data-push-dismiss>Later</button>
                </span>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted py-3 mt-4">
        <div class="container small d-flex justify-content-between flex-wrap">
            <span>&copy; 2026 DayPilot</span>
            <span>Plan. Complete. Move Forward.</span>
        </div>
    </footer>

    <div class="toast-container position-fixed bottom-0 end-0 p-3" id="notificationContainer">
        @if (TempData["Success"] is string success)
        {
            <div class="toast align-items-center text-bg-success border-0 dp-toast" role="alert" aria-live="assertive">
                <div class="d-flex">
                    <div class="toast-body"><i class="bi bi-check-circle"></i> @success</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="toast align-items-center text-bg-danger border-0 dp-toast" role="alert" aria-live="assertive">
                <div class="d-flex">
                    <div class="toast-body"><i class="bi bi-exclamation-triangle"></i> @error</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            </div>
        }
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (signedIn)
    {
        <script>window.dpSpeakReminders = @(speakReminders ? "true" : "false");</script>
        <script src="~/js/notifications.js" asp-append-version="true"></script>
        <script src="~/js/reminders.js" asp-append-version="true"></script>
        <script src="~/js/command-palette.js" asp-append-version="true"></script>
        <script src="~/js/pomodoro.js" asp-append-version="true"></script>
        if (!string.IsNullOrWhiteSpace(vapidKey))
        {
            <script>window.dpVapidKey = '@vapidKey';</script>
            <script src="~/js/push.js" asp-append-version="true"></script>
        }
    }
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
        }
    </script>
</body>
</html>
